[Unit]
Description=voice-input hold-to-talk daemon (hold Right Alt to dictate)
# Zima CR round-3 发现 3:After= 不带 WantedBy 的目标不会建立顺序,daemon 在
# WAYLAND_DISPLAY 导出前启动 → GTK 浮层终身丢失。规范接法:挂到
# graphical-session.target(KDE systemd 启动时会激活它并 import 环境);
# 浮层本身也做了惰性初始化双保险。
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/work/git-repo/voice-input/voice_hold.py
# NPU 引擎(#19/#27):stateful 管线 + 构造期 word_timestamps(热词启用)。
# 首次转写一次性冷编译 ~155s——超时给 240s 兜住;之后热缓存加载 ~1.4s/次,
# 转写 ~1.0s/次。编译缓存 ~/.cache/voice-input/npu-compile-cache(~2.4GB,
# 含历史静态管线条目;可 rm 整目录重建,代价一次 155s 冷编译)。
# 常驻 worker 免每次加载见 #25。
# 无需 LD_LIBRARY_PATH——voice_hold 会给转写子进程自动注入。
# cpu 备选(无 NPU 机器):VOICE_INPUT_ENGINE=cpu + VOICE_INPUT_MODEL=small
Environment=VOICE_INPUT_ENGINE=npu
Environment=VOICE_INPUT_MODEL=small-int8-ov
Environment=VOICE_INPUT_TRANSCRIBE_TIMEOUT=240
Restart=always
RestartSec=3
# #28: exit 4 = another voice_hold already holds the singleton flock.
# Never restart-loop on it — the other instance is the live one; stopping
# it and `systemctl --user restart voice-hold` is the recovery path.
RestartPreventExitStatus=4

[Install]
WantedBy=graphical-session.target
